#!/bin/sh
# livedemo-vpn-net-up: forwarding + NAT for the VPN; safe to run repeatedly
sysctl -q -w net.ipv4.ip_forward=1
iptables -t nat -C POSTROUTING -s 10.8.0.0/24 -o ens5 -j MASQUERADE 2>/dev/null ||
  iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o ens5 -j MASQUERADE
iptables -t nat -C POSTROUTING -o tun0 -j MASQUERADE 2>/dev/null ||
  iptables -t nat -A POSTROUTING -o tun0 -j MASQUERADE